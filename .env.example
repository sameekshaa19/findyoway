# ============================================================
#  FindYoWay — Shared Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# Supabase (used by: mobile app + web dashboard directly)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Gemini API (used by: Flask backend)
GOOGLE_API_KEY=your-gemini-api-key-here

# Google Cloud Vision API (used by: mobile app — obstacle detection + sign reading)
# expo-constants exposes EXPO_PUBLIC_ prefixed vars to the app at runtime
EXPO_PUBLIC_VISION_API_KEY=your-google-vision-api-key-here

# Flask backend URL (used by: mobile app to call Gemini routes)
# Change this to your laptop's local IP when testing on a real device
# e.g. http://192.168.1.10:5000
EXPO_PUBLIC_FLASK_API_URL=http://localhost:5000

# Flask Configuration
FLASK_DEBUG=False
PORT=5000

# Dashboard (Vite) - prefixed with VITE_
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:5000
