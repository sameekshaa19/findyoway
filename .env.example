# ============================================================
#  FindYoWay — Shared Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# Supabase (used by: mobile app + web dashboard directly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Gemini API (used by: Flask backend)
GEMINI_API_KEY=your-gemini-api-key-here

# Flask backend URL (used by: mobile app to call Gemini routes)
# Change this to your laptop's local IP when testing on a real device
# e.g. http://192.168.1.10:5000
BACKEND_URL=http://localhost:5000

# Expo (mobile)
# For Vite/dashboard, prefix these with VITE_
# VITE_SUPABASE_URL=  (copy values from above)
# VITE_SUPABASE_ANON_KEY=
# VITE_BACKEND_URL=
